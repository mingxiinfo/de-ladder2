# host-nginx 上给架构图站点加的转发（docs/31）。只对内网：只监听 LAN 地址，不对 Domestic 开放。
# 域名用现有的内部后缀，不新造（docs/18）。没有实测。
server {
    listen 192.168.1.4:80;
    server_name <内部域名>;
    access_log /var/log/nginx/ladder2.access.log ladder2;

    location / {
        proxy_pass http://127.0.0.1:18310;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $ladder2_rid;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}
