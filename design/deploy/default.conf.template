# 容器里的 Nginx。只发静态文件，不转发任何东西。
# 启动时由官方镜像的 20-envsubst-on-templates.sh 渲染到 /etc/nginx/conf.d/（compose 里是 tmpfs）。
# 只替换 DESIGN_ 开头的环境变量（NGINX_ENVSUBST_FILTER），$uri 这类 Nginx 变量原样保留。
# DESIGN_LISTEN 由 manage.sh 决定（docs/31）：
#   host 网络（Linux 服务器）  127.0.0.1:18310  只听本机回环，不建 Docker 网络、不加 iptables 规则
#   bridge 网络（开发机）       18310            容器自己的网络里监听，由端口映射接到本机 127.0.0.1
server {
    listen ${DESIGN_LISTEN};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_types text/html text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    # 图和首页每次更新都会变，不让浏览器长期缓存
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
    }
}
