# mx-launcher-internal-config：Launcher API 的环境变量（docs/46、docs/47）。
# 从 L1 deploy/k8s/internal-shadow/10-configmap.yaml 抄来，下面标了 L2 改过的。
# 这里不放任何凭据。凭据见 ../secrets.list，用 ./scripts/manage.sh secret apply 建。
NODE_ENV=production
HOST=0.0.0.0
PORT=18090
LOG_LEVEL=info
MX_HTTP_TRUST_PROXY_HOPS=1
# L2：API 不再经过应用网关，前面是 host-nginx 和 Gateway internal（Pod）。按地址段信任代理，
# Express 取 X-Forwarded-For 里从右往左第一个不在这里面的地址当客户端，优先于上面的 HOPS（docs/47）。
# 和网关的 trustedAddresses 同一套：Pod 网段（versions.env 的 POD_CIDR）加 s2 的 LAN 地址。check 会核对
MX_HTTP_TRUST_PROXY_CIDRS=192.168.224.0/20,192.168.1.4/32
# L2：s2 这套的环境名，不能和 s1 的 shadow 相同（docs/15 第 44 项的建议值）
MX_ENVIRONMENT=ladder2
MX_SITE_ID=internal-main
MX_SITE_ROLE=internal
# L2：去掉了 edge-sync。打开它 s2 的 Launcher 会往生产的边缘推配置（docs/36）
MX_ENABLED_MODULES=iam,app-center,config-center,deploy-center,release-center,artifact-center,runner-controller,test-center,audit-center,observability,sdk-gateway,launcher-network-control,hdi-compat,dns-control
# Launcher 的 Internal 角色地址 10.88.88.88，跟着角色走，s2 那套也用它（用户 2026-11-22 定的，docs/48）。
# Launcher 的 DNS 记录、客户端快照、地址规划都写死了它（72 处），不改。s2 自己的边缘隧道地址是 .89，和这个无关。
# 要和 ../dns/coredns.yaml 的 externalIPs、bootstrap 的 Corefile 一致（check 会核对）
MX_PUBLIC_BASE_URL=http://10.88.88.88:18090
MX_INTERNAL_BASE_URL=http://mx-launcher-internal.mx-internal-shadow.svc.cluster.local:18090
# Hub 还没迁（docs/36 的顺序），连不上时按 L1 的 2.5 秒超时放弃
MX_INSIGHT_HUB_ADMIN_URL=http://mx-insight-hub-admin.mx-insight-hub.svc.cluster.local:18151
MX_INSIGHT_HUB_ADMIN_TIMEOUT_MS=2500
MX_INSIGHT_HUB_ADMIN_ENTRYPOINT=
INTERNAL_STORE_DRIVER=postgres
OBSERVABILITY_SINKS=[]
RUNNER_DRY_RUN_DEFAULT=1
# L2：切换前一律关（docs/36"切换前必须关掉的"）。L1 的 Deployment 里还用 env 再设成 1，L2 的没有
SITE_SLOT_RUNNER_REMOTE_EXECUTION_ENABLED=0
SITE_SLOT_WORKER_REMOTE_SSH=0
SITE_SLOT_CONFIRM_REMOTE_EXECUTION=0
SITE_SLOT_SSH_PASSWORD_BOOTSTRAP_ENABLED=0
SITE_SLOT_SSH_READONLY_PROBE_EXECUTE=0
SITE_SLOT_DOMESTIC_WG_SECRET_EXPORT_ENABLED=0
MX_INTERNAL_HOST_RUNNER_URL=http://host.docker.internal:19190
MX_INTERNAL_HOST_RUNNER_K8S_URL=http://mx-internal-host-runner.mx-internal-shadow.svc.cluster.local:19190
# L2：host-runner 由 Launcher 自己建（管理界面 → Ensure K8s Fallback），权限在 host-runner.yaml（docs/47）。
# L1 正式环境用的是宿主机上的 native host-runner（L1 deploy 里的 native_host_runner_install），L2 不装那个
MX_INTERNAL_HOST_RUNNER_K8S_FALLBACK_ENABLED=1
MX_INTERNAL_HOST_RUNNER_K8S_ENSURE_ENABLED=1
# L2 加的：只在持有 service peer 的节点上跑（scripts/roles/control/40-cluster.sh 给 s2 打这个标签）
MX_INTERNAL_HOST_RUNNER_NODE_SELECTOR=mx.ladder2/site-peer=true
MX_INTERNAL_HOST_RUNNER_K8S_NAMESPACE=mx-internal-shadow
MX_INTERNAL_HOST_RUNNER_K8S_NAME=mx-internal-host-runner
# L2：镜像和 overlays/ladder2 的 images 一致（manage.sh check 会核对）
MX_INTERNAL_HOST_RUNNER_IMAGE=localhost/ladder2/mx-launcher-server:l2-2
MX_INTERNAL_HOST_RUNNER_IMAGE_PULL_POLICY=IfNotPresent
MX_SITE_SLOT_SSH_KEY_DIR=/app/artifacts/ssh
SITE_SLOT_ARTIFACT_BASE_DIR=/app/runtime-artifacts/site-slots
SITE_SLOT_ARTIFACT_OUTPUT_DIR=/app/runtime-artifacts/site-slots
AWX_BASE_URL=http://mx-awx-service.mx-awx.svc.cluster.local
AWX_ORGANIZATION=MX Internal
AWX_PROJECT=mx-launcher-site-slots
AWX_API_CREDENTIAL_SYNC_ENABLED=0
AWX_API_OBJECT_SYNC_ENABLED=0
AWX_API_LAUNCH_ENABLED=0
# L2：分流 DNS 在 ../dns/（mx-dns/mx-internal-coredns），管理界面的 DNS 页面 Apply 时改 mx-dns/coredns（docs/47）
COREDNS_K8S_APPLY_ENABLED=1
COREDNS_K8S_ALLOWED_NAMESPACE=mx-dns
COREDNS_K8S_ALLOWED_CONFIGMAP_NAME=coredns
GATEWAY_K8S_APPLY_ENABLED=1
GATEWAY_K8S_ALLOWED_NAMESPACE=mx-internal-shadow
GATEWAY_K8S_ALLOWED_CONFIGMAP_NAME=mx-internal-gateway-caddy
GATEWAY_APPLY_BACKEND=k8s
GATEWAY_HOST_NGINX_APPLY_ENABLED=0
GATEWAY_HOST_NGINX_CONFIG_PATH=/etc/nginx/conf.d/mx-gateway.generated.conf
GATEWAY_HOST_NGINX_K8S_RUNNER_ENABLED=0
GATEWAY_APP_PORT=80
# L2：应用网关换成了 nginx，读同一个 ConfigMap 里的 nginx.conf（app-gateway.yaml）。路由的目标是 Launcher 自己时，
# nginx.conf 默认写 127.0.0.1:18090（L1 宿主机 Nginx 的写法），在 Pod 里要指到 Service（docs/47）
GATEWAY_HOST_NGINX_INTERNAL_API_UPSTREAM=http://mx-launcher-internal.mx-internal-shadow.svc.cluster.local:18090
# Launcher 同时还生成一份 Caddyfile（L2 已不用 Caddy）。留着这一项，万一切回 Caddy 时它的客户端地址也是对的（docs/46）
GATEWAY_TRUSTED_PROXY_CIDRS=192.168.224.0/20,192.168.1.4/32
MX_LAUNCHER_NETWORK_LEGACY_UNAUTHENTICATED_USER_LEASES=0
MX_LAUNCHER_NETWORK_HANDOVER_TTL_MS=300000
MX_LAUNCHER_NETWORK_HANDOVER_RECONCILE_MS=30000
MX_LAUNCHER_NETWORK_RUNTIME_SNAPSHOT_INTERVAL_MS=300000
MX_LAUNCHER_NETWORK_RUNTIME_SNAPSHOT_RETENTION_SAMPLES=288
MX_FEISHU_REDIRECT_URIS=http://127.0.0.1:17891/oauth/feishu/callback
MX_FEISHU_AUTO_PROVISION_ENABLED=1
MX_RELEASE_ARTIFACT_STORE_DIR=/app/artifacts/release-center
