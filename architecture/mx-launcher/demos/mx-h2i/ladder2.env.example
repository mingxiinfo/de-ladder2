# L2（de-ladder2 docs/49）：连 s2 那套 Launcher 测试用。拷成同目录的 .env（.env 不进 Git）。
# 打包后的客户端读安装包 Resources/ 下的 .env；开发时（pnpm dev）读本目录的 .env。
#
# 地址用 127.0.0.1：飞书登录和 MinCave 的权限检查不走明文 HTTP 连局域网 IP，只认 HTTPS、127.0.0.1
# 或已验证的隧道。先在本机开一个到 s2 的转发（s2 上 host-nginx 的 18090 只放内网和本机）：
#   ssh -N -L 18090:127.0.0.1:18090 root@<s2 地址>
# 用 IP、不用域名，和 v1 的 DNS 不冲突。
MX_H2I_BOOTSTRAP_BASE_URL=http://127.0.0.1:18090
MX_H2I_UI=mincave
# 登录页连点 5 下 logo 出现账号密码登录。s2 的 Launcher 也要开 MX_MINCAVE_PASSWORD_LOGIN_ENABLED（config.env 里已开）。
MX_H2I_MINCAVE_PASSWORD_LOGIN=1
