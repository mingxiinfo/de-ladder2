# 钉住的版本。只在这里写版本号，改完跑 ./scripts/manage.sh check。
# 新集群用 kubeadm，版本和 CNI 与 s1 保持一致（docs/16）。
# K8S / FLANNEL 抄自 L1 的 mx-launcher/scripts/install-k8s-centos.sh 的默认值。
K8S_MINOR=v1.36
# 补丁版本。留空表示装 K8S_MINOR 的最新补丁；要和 s1 一致（docs/16），在 s1 上 kubectl version 看到后填，例如 v1.36.2。
K8S_VERSION=
# 控制面镜像从哪拉。默认官方仓库，containerd 走 PROXY（docs/35）。
# 国内不走代理时可以改成 registry.aliyuncs.com/google_containers（L1 install-k8s-centos.sh 的示例写法）。
K8S_IMAGE_REPOSITORY=registry.k8s.io
FLANNEL_VERSION=v0.28.5
# NGF / CNPG 抄自 cc-studio/infra/k8s/versions.env（那边 2026-11-16 核对过发布页）。
# 本工程没有重新核对，也没在集群上跑过。第一次安装前再查一遍，包括它们是否支持 v1.36。
NGF_VERSION=2.8.1
CNPG_VERSION=1.30.1
# 下面四个 2026-11-19 按搜索到的发布页写的（docs/35），没在集群上跑过。helm 留在 v3：NGF 的安装命令是按 v3 写的。
HELM_VERSION=v3.21.0
LOCAL_PATH_VERSION=v0.0.37
METRICS_SERVER_VERSION=v0.8.1
K6_IMAGE=grafana/k6:1.8.2
# 节点上构建镜像（docs/55）：buildkitd 直接把镜像建进 containerd 的 k8s.io，不用 docker、不用镜像仓库。
# 按记得的发布版本写的，没核对发布页，也没在 s2 上跑过。
BUILDKIT_VERSION=v0.18.2
# 两个网关的 NodePort（docs/18）。public 接公网来的流量，internal 只接内网和 H2I 用户。
GATEWAY_PUBLIC_NODEPORT=30080
GATEWAY_INTERNAL_NODEPORT=30081
# 网段，沿用 v1（s1）的规划：抄自 L1 的 mx-launcher/scripts/install-k8s-centos.sh 默认值和 docs/11-k8s-deployment-runbook.md。
# 10.0.0.0/8 归 Launcher 的应用（10.88 中继，产品按 10.(90+n) 往上分），100.* 是 HDO V1 和 tunnel-cli 的隧道，172.16-31 是 Docker（docs/41）。
POD_CIDR=192.168.224.0/20
SERVICE_CIDR=192.168.240.0/20
