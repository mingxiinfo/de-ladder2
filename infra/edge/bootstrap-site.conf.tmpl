# 测试中继上的公网站点（docs/59、docs/60、docs/61）。由 ./scripts/manage.sh relay <主机> site 渲染进边缘工具的 state
# （/var/lib/qp-tunnel/edge/state/<主机>/wg-nginx/nginx/ladder2-bootstrap.conf），edge push 以后装成
# /etc/nginx/conf.d/qp-edge-wg-nginx--ladder2-bootstrap.conf。不要在目标机上手改：重新 push 会覆盖。
# 这个文件是公共部分（白名单、来源、模式），每个域名一段 server 来自 bootstrap-site.server.tmpl。
# 占位：@ADMIN_ALLOW@ restricted 模式下能进控制面的来源（geo 的行）。

# 客户端接口：照 Launcher 的 Caddyfile.public-tls（v1 生产 h2i.minsight-ai.com 的白名单），按 method 加 path 收口
map "$request_method $uri" $ladder2_bootstrap_public {
    default 0;
    "~^GET /(healthz|bootstrap-healthz|internal-healthz)$" 1;
    "~^POST /internal/v1/mincave/session$" 1;
    "~^GET /internal/v1/mincave/(devices|members)$" 1;
    "~^PATCH /internal/v1/mincave/workspace$" 1;
    "~^PATCH /internal/v1/mincave/members/[A-Za-z0-9._-]+$" 1;
    "~^GET /internal/v1/sdk/oauth/feishu/config$" 1;
    "~^GET /internal/v1/launcher-network/products/[A-Za-z0-9._-]+$" 1;
    "~^GET /internal/v1/oversea-subscriptions/mx-v1-[A-Za-z0-9_-]+\.yaml$" 1;
    "~^GET /internal/v1/site-slots/[A-Za-z0-9._-]+/subscriptions/hysteria2/[A-Za-z0-9._-]+\.yaml$" 1;
    "~^POST /internal/v1/(sdk/oauth/token|sdk/oauth/feishu/authorize|sdk/oauth/feishu/token|launcher-network/enrollments|launcher-network/snapshots)$" 1;
    "~^POST /internal/v1/launcher-network/leases/[A-Za-z0-9._-]+/(release|domestic-peer/sync|internal-direct-peer/sync|domestic-relay/diagnostics)$" 1;
}
# restricted 模式下能进控制面的来源（relay <主机> site --admin-allow <IP,...>）
geo $ladder2_bootstrap_admin {
    default 0;
@ADMIN_ALLOW@
}
# 每个域名在自己的 server 里 set $ladder2_site_mode：
#   client     只放客户端接口（bootstrap 域名的默认，和 v1 的 h2i.minsight-ai.com 一样）
#   open       全部放行，鉴权交给 Launcher（管理域名的默认，docs/60）
#   restricted 客户端接口 + 登记的来源能进其余
map "$ladder2_site_mode:$ladder2_bootstrap_public$ladder2_bootstrap_admin" $ladder2_bootstrap_allow {
    default          0;
    "~^open:"        1;
    "~^client:1"     1;
    "~^restricted:1" 1;
    "~^restricted:01" 1;
}
map $http_upgrade $ladder2_bootstrap_upgrade {
    default upgrade;
    ""      close;
}
