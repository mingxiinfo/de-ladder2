# 测试中继上 bootstrap 域名的站点（docs/59）。由 ./scripts/manage.sh relay <主机> site 渲染进边缘工具的 state
# （/var/lib/qp-tunnel/edge/state/<主机>/wg-nginx/nginx/ladder2-bootstrap.conf），edge push 以后装成
# /etc/nginx/conf.d/qp-edge-wg-nginx--ladder2-bootstrap.conf。不要在目标机上手改：重新 push 会覆盖。
# 占位：@DOMAIN@ 域名；@UPSTREAM@ s2 的 18090（经边缘隧道）；@ACME_UPSTREAM@ s2 上 certbot 临时监听的地址；
# @ADMIN_ALLOW@ 能进管理后台的来源（geo 的行）；@TLS_BEGIN@ … @TLS_END@ 证书还没签时整段去掉。

# 公网上任何人都能用的接口：照 Launcher 的 Caddyfile.public-tls（v1 生产的白名单），按 method 加 path 收口
map "$request_method $uri" $ladder2_bootstrap_public {
    default 0;
    "~^GET /(healthz|bootstrap-healthz|internal-healthz)$" 1;
    "~^POST /internal/v1/mincave/session$" 1;
    "~^GET /internal/v1/mincave/(devices|members)$" 1;
    "~^PATCH /internal/v1/mincave/workspace$" 1;
    "~^PATCH /internal/v1/mincave/members/[A-Za-z0-9._-]+$" 1;
    "~^GET /internal/v1/sdk/oauth/feishu/config$" 1;
    "~^GET /internal/v1/launcher-network/products/[A-Za-z0-9._-]+$" 1;
    "~^GET /internal/v1/oversea-subscriptions/mx-v1-[A-Za-z0-9_-]+\.yaml$" 1;
    "~^GET /internal/v1/site-slots/[A-Za-z0-9._-]+/subscriptions/hysteria2/[A-Za-z0-9._-]+\.yaml$" 1;
    "~^POST /internal/v1/(sdk/oauth/token|sdk/oauth/feishu/authorize|sdk/oauth/feishu/token|launcher-network/enrollments|launcher-network/snapshots)$" 1;
    "~^POST /internal/v1/launcher-network/leases/[A-Za-z0-9._-]+/(release|domestic-peer/sync|internal-direct-peer/sync|domestic-relay/diagnostics)$" 1;
}
# 管理后台和其余控制面接口：只给登记的来源（relay <主机> site --admin-allow）。没登记时谁都进不了，用 SSH 隧道
geo $ladder2_bootstrap_admin {
    default 0;
@ADMIN_ALLOW@
}
map "$ladder2_bootstrap_public$ladder2_bootstrap_admin" $ladder2_bootstrap_allow {
    default 1;
    "00"    0;
}
map $http_upgrade $ladder2_bootstrap_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name @DOMAIN@;
    # 签证书：Let's Encrypt 来这里取挑战，转给 s2 上的 certbot（经边缘隧道）
    location /.well-known/acme-challenge/ {
        proxy_pass http://@ACME_UPSTREAM@;
        proxy_set_header Host $host;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
@TLS_BEGIN@
server {
    listen 443 ssl;
    http2 on;
    server_name @DOMAIN@;
    ssl_certificate     @STATE_DIR@/certs/@DOMAIN@.crt;
    ssl_certificate_key @STATE_DIR@/certs/@DOMAIN@.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2g;

    location = /healthz {
        default_type application/json;
        return 200 '{"ok":true,"service":"ladder2-bootstrap-edge","role":"domestic"}';
    }
    location ~ ^/(bootstrap-healthz|internal-healthz)$ {
        rewrite ^ /healthz break;
        proxy_pass http://@UPSTREAM@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-MX-Forwarded-By domestic-edge;
    }
    location / {
        if ($ladder2_bootstrap_allow = 0) { return 404 "not found\n"; }
        proxy_pass http://@UPSTREAM@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ladder2_bootstrap_upgrade;
        # 覆盖，不追加：客户端自己带的 X-Forwarded-For 不算（v1 的规矩）
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-MX-Forwarded-By domestic-edge;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
@TLS_END@
