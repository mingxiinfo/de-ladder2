# ---- @DOMAIN@（@ROLE@，@MODE@）----
server {
    listen 80;
    server_name @DOMAIN@;
    # 签证书：Let's Encrypt 来这里取挑战，转给 s2 上的 certbot（经边缘隧道）
    location /.well-known/acme-challenge/ {
        proxy_pass http://@ACME_UPSTREAM@;
        proxy_set_header Host $host;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
@TLS_BEGIN@
server {
    listen 443 ssl;
    http2 on;
    server_name @DOMAIN@;
    ssl_certificate     @STATE_DIR@/certs/@DOMAIN@.crt;
    ssl_certificate_key @STATE_DIR@/certs/@DOMAIN@.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2g;
    # 本机直接回的（拒绝的 404 等）按纯文本给：默认的 application/octet-stream 会让 Chrome 报 ERR_INVALID_RESPONSE
    default_type text/plain;
    set $ladder2_site_mode @MODE@;

    location = /healthz {
        default_type application/json;
        return 200 '{"ok":true,"service":"ladder2-bootstrap-edge","role":"domestic"}';
    }
    # 这台看到的来源地址，restricted 模式和它比（docs/59）
    location = /ladder2-whoami {
        add_header Cache-Control "no-store" always;
        return 200 "$remote_addr\n";
    }
    location ~ ^/(bootstrap-healthz|internal-healthz)$ {
        rewrite ^ /healthz break;
        proxy_pass http://@UPSTREAM@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-MX-Forwarded-By domestic-edge;
    }
    location / {
        if ($ladder2_bootstrap_allow = 0) { return 404 "not found\n"; }
        proxy_pass http://@UPSTREAM@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ladder2_bootstrap_upgrade;
        # 覆盖，不追加：客户端自己带的 X-Forwarded-For 不算（v1 的规矩）
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-MX-Forwarded-By domestic-edge;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
@TLS_END@
